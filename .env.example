PORT=4000
NEON_DATABASE_URL=
# Optional, read-only Neon URL for `npm run db:audit:neon`; never share or commit the URL.
POWERWATCH_AUDIT_DATABASE_URL=
PERSISTENT_AUTH_REQUIRED=false
PUBLIC_BASE_URL=http://localhost:4000

# Isolated Neon development branch only. Never point this at production.
# NEON_DEV_DATABASE_URL=
# POWERWATCH_ALLOW_NEON_DEV=1
# POWERWATCH_SQLITE_PATH=data/powerwatch.db

# Optional read-only production source for resident_accounts/resident_sessions.
# POWERWATCH_SOURCE_NEON_URL=

# Neon branch creation (control plane; keep the API key out of source control).
# NEON_API_KEY=
# NEON_PROJECT_ID=soft-rain-77737541
# NEON_DEV_BRANCH_NAME=development
# NEON_PARENT_BRANCH_ID=
# NEON_DB_NAME=neondb
# NEON_DB_ROLE=neondb_owner

# One-off schema deployment to the Neon branch that Render uses. Only needed for
# `npm run db:deploy:apply`; it allows additive DDL on NEON_DATABASE_URL.
# Never keep this enabled in a running service.
# POWERWATCH_ALLOW_PRODUCTION_DDL=1

# One-off reference-data seed (31 barangays + configuration settings) into the
# same branch. Only needed for `npm run db:seed:reference:apply`.
# Never keep this enabled in a running service.
# POWERWATCH_ALLOW_PRODUCTION_SEED=1

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=