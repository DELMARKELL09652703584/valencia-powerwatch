{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start PowerWatch server",
      "type": "shell",
      "command": "npm",
      "args": ["start"],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Start PowerWatch (dev watch mode)",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run full test suite",
      "type": "shell",
      "command": "npm",
      "args": ["test"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Neon staging validation (read-only)",
      "type": "shell",
      "command": "npm",
      "args": ["run", "db:validate:neon"],
      "problemMatcher": []
    },
    {
      "label": "Neon production audit (read-only)",
      "type": "shell",
      "command": "npm",
      "args": ["run", "db:audit:neon"],
      "problemMatcher": []
    },
    {
      "label": "Git status",
      "type": "shell",
      "command": "git",
      "args": ["status", "--short", "--branch"],
      "problemMatcher": []
    }
  ]
}
