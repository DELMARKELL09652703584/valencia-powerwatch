{
  "name": "valencia-powerwatch",
  "version": "1.0.0",
  "description": "Valencia PowerWatch - Community Power Interruption Reporting, Verification, and Information Management System for Valencia City, Bukidnon",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/start.js",
    "start:local": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test",
    "migrate:resident-accounts": "node scripts/migrate-residents-to-neon.js",
    "db:branch:create": "node scripts/create-neon-dev-branch.js",
    "db:migrate:neon": "node scripts/neon-migrate.js",
    "db:backfill:neon": "node scripts/neon-backfill.js",
    "db:validate:neon": "node scripts/neon-validate.js",
    "db:audit:neon": "node scripts/neon-audit-readonly.js",
    "db:staging": "npm run db:migrate:neon && npm run db:backfill:neon && npm run db:validate:neon",
    "db:deploy": "node scripts/neon-deploy-schema.js",
    "db:deploy:apply": "node scripts/neon-deploy-schema.js --apply",
    "db:seed:reference": "node scripts/neon-seed-reference.js",
    "db:seed:reference:apply": "node scripts/neon-seed-reference.js --apply"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "license": "MIT",
  "dependencies": {
    "compression": "^1.8.2",
    "dotenv": "^18.0.4",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.12",
    "pg": "^8.23.1"
  }
}
